{
  "name": "secretengerl",
  "version": "0.3.0",
  "private": true,
  "description": "Engerl-Bengerl, the Austrian Secret Santa: Wichteln and Secret Santa without a server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p src/sw && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.ts",
    "check:hygiene": "scripts/check-hygiene.sh HEAD",
    "check:size": "node scripts/check-size.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "marked": "18.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
